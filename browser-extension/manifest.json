{
  "manifest_version": 3,
  "name": "Linked Jobs Route Planner Sync",
  "version": "1.1.0",
  "description": "Posts visible job rows from supported signed-in job boards to the local route planner.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:3300/*", "http://localhost:3300/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.jobslingerplus.com/MegaLog*",
        "https://survey.com/*",
        "https://*.survey.com/*",
        "https://workplace.clickworker.com/*",
        "https://*.clickworker.com/*",
        "https://fieldnation.com/*",
        "https://*.fieldnation.com/*",
        "https://app.fieldagent.net/*",
        "https://*.fieldagent.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
